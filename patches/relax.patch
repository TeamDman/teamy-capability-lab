+    let file = std::env::temp_dir().join(format!("relax-native-args-{}.txt", std::process::id()));
+    std::fs::write(&file, "--crate-name\r\napplication\r\n--out-dir\r\na path with spaces\r\n@inside\r\n").unwrap();
+    let args = [OsString::from("--test"), format!("@{}", file.display()).into()];
+    let parsed = cargo_rustc_args(&args).unwrap();
+    std::fs::remove_file(file).unwrap();
