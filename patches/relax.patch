+/// Cargo moves long rustc commands to an @file on Windows. Inspect its UTF-8 lines as
+/// arguments, without splitting paths on spaces or expanding @ arguments nested in the file.
+fn cargo_rustc_args(args: &[std::ffi::OsString]) -> Result<Vec<std::ffi::OsString>, String> {
+    let mut expanded = Vec::with_capacity(args.len());
+    for arg in args {
+        if let Some(path) = arg.to_str().and_then(|s| s.strip_prefix('@')) {
+            let file = std::fs::read_to_string(path).map_err(|e| format!("cannot read cargo rustc argument file {path}: {e}"))?;
+            expanded.extend(file.lines().map(std::ffi::OsString::from));
+        } else {
+            expanded.push(arg.clone());
+        }
+    }
+    Ok(expanded)
+}
