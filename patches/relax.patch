+impl Attr {
+    /// The attribute's meta item, inside `unsafe(...)` when present.
+    pub fn meta_tokens(&self, kind: impl Fn(u32) -> crate::lexer::T) -> TokRange {
+        use crate::lexer::T;
+        let TokRange { lo, hi } = self.toks;
+        if hi >= lo + 4 && kind(lo) == T::KwUnsafe && kind(lo + 1) == T::OpenParen && kind(hi - 1) == T::CloseParen {
+            TokRange { lo: lo + 2, hi: hi - 1 }
+        } else {
+            self.toks
+        }
+    }
+}
